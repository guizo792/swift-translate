{
  "manifest_version": 3,
  "name": "Swift Translate",
  "version": "1.3.0",
  "description": "Select text on any page to translate it instantly, with meanings, examples, voice, 80+ languages and a saved-words list.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["languages.js", "content.js"]
    }
  ],
  "action": {
    "default_title": "Swift Translate",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}